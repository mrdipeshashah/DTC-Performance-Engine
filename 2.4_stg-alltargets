CREATE OR REPLACE VIEW `mrdipeshashah.Forecasting.stg_alltargets` AS
SELECT
  CAST(Month AS DATE) AS Month,
  CAST(Spend_Target AS NUMERIC) AS Spend_Target,
  CAST(Conversions_Target AS INT64) AS Conversions_Target,
  CAST(Revenue_Target AS NUMERIC) AS Revenue_Target,
  CAST(Total_Customers_Target AS INT64) AS Total_Customers_Target,
  CAST(New_Customers_Target AS INT64) AS New_Customers_Target,
  CAST(Profit_Target AS NUMERIC) AS Profit_Target
FROM `mrdipeshashah.Forecasting.alltargets`;
