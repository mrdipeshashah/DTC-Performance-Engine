WITH aggregated_ga AS (
  SELECT
    Month,
    SUM(Sessions) AS Total_GA_Sessions,
    SUM(GA_Transactions) AS Total_GA_Transactions,
    SUM(GA_Revenue) AS Total_GA_Revenue
  FROM `mrdipeshashah.Forecasting.stg_monthlygoogleanalytics`
  GROUP BY 1
),

-- 1️⃣ Added Paid Media Aggregation CTE
aggregated_paidmedia AS (
  SELECT
    DATE_TRUNC(date, MONTH) AS Month,
    SUM(cost) AS Actual_Spend
  FROM `mrdipeshashah.Forecasting.stg_paidmedia`
  GROUP BY 1
)

SELECT
  COALESCE(s.Month, ga.Month, pm.Month, t.Month) AS Month,

  -- Live Date Pacing Helpers (For Looker Studio Run-Rate)
  EXTRACT(DAY FROM CURRENT_DATE()) AS current_day_of_month,
  EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS days_in_current_month,

  -- Shopify Actuals
  COALESCE(s.Shopify_Orders, 0) AS Actual_Shopify_Orders,
  COALESCE(s.Shopify_Revenue, 0) AS Actual_Shopify_Revenue,
  COALESCE(s.Total_Customers, 0) AS Actual_Total_Customers,
  COALESCE(s.New_Customers, 0) AS Actual_New_Customers,
  COALESCE(s.Profit, 0) AS Actual_Profit,

  -- GA Actuals
  COALESCE(ga.Total_GA_Sessions, 0) AS Actual_GA_Sessions,
  COALESCE(ga.Total_GA_Transactions, 0) AS Actual_GA_Transactions,
  COALESCE(ga.Total_GA_Revenue, 0) AS Actual_GA_Revenue,

  -- 2️⃣ Added Actual Paid Spend Field
  COALESCE(pm.Actual_Spend, 0) AS Actual_Spend,

  -- Store Targets
  COALESCE(t.Spend_Target, 0) AS Target_Spend,
  COALESCE(t.Conversions_Target, 0) AS Target_Conversions,
  COALESCE(t.Revenue_Target, 0) AS Target_Revenue,
  COALESCE(t.Total_Customers_Target, 0) AS Target_Total_Customers,
  COALESCE(t.New_Customers_Target, 0) AS Target_New_Customers,
  COALESCE(t.Profit_Target, 0) AS Target_Profit,

  -- Static Delivery % Calculations
  SAFE_DIVIDE(s.Shopify_Revenue, t.Revenue_Target) AS Overall_Revenue_Delivery_Pct,
  SAFE_DIVIDE(s.Shopify_Orders, t.Conversions_Target) AS Overall_Order_Delivery_Pct,
  SAFE_DIVIDE(s.Profit, t.Profit_Target) AS Overall_Profit_Delivery_Pct,
  -- MoM Variance Calculations (Previous Month Comparisons)
  LAG(s.Shopify_Revenue) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Last_Month_Revenue,
  s.Shopify_Revenue - LAG(s.Shopify_Revenue) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Diff_MoM_Revenue,
  SAFE_DIVIDE(
    s.Shopify_Revenue - LAG(s.Shopify_Revenue) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)),
    LAG(s.Shopify_Revenue) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month))
  ) AS Diff_MoM_Revenue_Pct,

  LAG(pm.Actual_Spend) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Last_Month_Spend,
  pm.Actual_Spend - LAG(pm.Actual_Spend) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Diff_MoM_Spend,
  SAFE_DIVIDE(
    pm.Actual_Spend - LAG(pm.Actual_Spend) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)),
    LAG(pm.Actual_Spend) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month))
  ) AS Diff_MoM_Spend_Pct,

  LAG(s.New_Customers) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Last_Month_New_Customers,
  s.New_Customers - LAG(s.New_Customers) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Diff_MoM_New_Customers

FROM `mrdipeshashah.Forecasting.stg_monthlyshopify` s
FULL OUTER JOIN aggregated_ga ga
  ON s.Month = ga.Month
-- 3️⃣ Added FULL OUTER JOIN for Paid Media
FULL OUTER JOIN aggregated_paidmedia pm
  ON COALESCE(s.Month, ga.Month) = pm.Month
FULL OUTER JOIN `mrdipeshashah.Forecasting.stg_alltargets` t
  ON COALESCE(s.Month, ga.Month, pm.Month) = t.Month
