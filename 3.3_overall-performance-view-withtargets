WITH shopify_daily AS (
  SELECT
    DATE_TRUNC(`Date`, MONTH) AS Month,
    SUM(Shopify_Orders) AS Shopify_Orders,
    SUM(Shopify_Revenue) AS Shopify_Revenue,
    SUM(Total_Customers) AS Total_Customers,
    SUM(New_Customers) AS New_Customers,
    SUM(Profit) AS Profit
  FROM `entertablename.Forecasting.dailyshopify`
  WHERE `Date` < CURRENT_DATE()
  GROUP BY 1
),

-- 2. Daily MTD Paid Media Spend (Dynamic up to yesterday)
paidmedia_daily AS (
  SELECT
    DATE_TRUNC(`date`, MONTH) AS Month,
    SUM(cost) AS Actual_Spend
  FROM `entertablename.Forecasting.dailypaidmedia`
  WHERE `date` < CURRENT_DATE()
  GROUP BY 1
),

-- 3. Daily MTD GA4 Metrics (Dynamic up to yesterday)
ga_daily AS (
  SELECT
    DATE_TRUNC(`Date`, MONTH) AS Month,
    SUM(Sessions) AS Total_GA_Sessions,
    SUM(GA_Transactions) AS Total_GA_Transactions,
    SUM(GA_Revenue) AS Total_GA_Revenue
  FROM `entertablename.Forecasting.dailygoogleanalytics`
  WHERE `Date` < CURRENT_DATE()
  GROUP BY 1
)

SELECT
  COALESCE(s.Month, ga.Month, pm.Month, t.Month) AS Month,

  -- Live Date Pacing Helpers (Prevents 0-division on Day 1 of the month)
  GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1) AS current_day_of_month,
  EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS days_in_current_month,

  -- Shopify Actuals
  COALESCE(s.Shopify_Orders, 0) AS Actual_Shopify_Orders,
  COALESCE(s.Shopify_Revenue, 0) AS Actual_Shopify_Revenue,
  COALESCE(s.Total_Customers, 0) AS Actual_Total_Customers,
  COALESCE(s.New_Customers, 0) AS Actual_New_Customers,
  COALESCE(s.Profit, 0) AS Actual_Profit,

  -- GA4 Actuals
  COALESCE(ga.Total_GA_Sessions, 0) AS Actual_GA_Sessions,
  COALESCE(ga.Total_GA_Transactions, 0) AS Actual_GA_Transactions,
  COALESCE(ga.Total_GA_Revenue, 0) AS Actual_GA_Revenue,

  -- Paid Media Actual Spend
  COALESCE(pm.Actual_Spend, 0) AS Actual_Spend,

  -- Store Monthly Targets
  COALESCE(t.Spend_Target, 0) AS Target_Spend,
  COALESCE(t.Conversions_Target, 0) AS Target_Conversions,
  COALESCE(t.Revenue_Target, 0) AS Target_Revenue,
  COALESCE(t.Total_Customers_Target, 0) AS Target_Total_Customers,
  COALESCE(t.New_Customers_Target, 0) AS Target_New_Customers,
  COALESCE(t.Profit_Target, 0) AS Target_Profit,

  -- Projected Run-Rate Calculations (Safe for Day 1)
  SAFE_DIVIDE(COALESCE(s.Shopify_Revenue, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) 
    * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS Projected_Total_Revenue,

  SAFE_DIVIDE(COALESCE(s.Profit, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) 
    * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS Projected_Total_Profit,

  SAFE_DIVIDE(COALESCE(s.Shopify_Orders, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) 
    * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS Projected_Total_Orders,

  SAFE_DIVIDE(COALESCE(pm.Actual_Spend, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) 
    * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS Projected_Spend,

  -- Projected Delivery / Pacing % Calculations
  SAFE_DIVIDE(
    SAFE_DIVIDE(COALESCE(s.Shopify_Revenue, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())),
    NULLIF(t.Revenue_Target, 0)
  ) AS Projected_Revenue_Delivery_Pct,

  SAFE_DIVIDE(
    SAFE_DIVIDE(COALESCE(s.Profit, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())),
    NULLIF(t.Profit_Target, 0)
  ) AS Projected_Profit_Delivery_Pct,

  SAFE_DIVIDE(
    SAFE_DIVIDE(COALESCE(s.Shopify_Orders, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())),
    NULLIF(t.Conversions_Target, 0)
  ) AS Projected_Orders_Delivery_Pct,

  SAFE_DIVIDE(
    SAFE_DIVIDE(COALESCE(pm.Actual_Spend, 0), GREATEST(EXTRACT(DAY FROM CURRENT_DATE() - 1), 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())),
    NULLIF(t.Spend_Target, 0)
  ) AS Spend_Pacing_Pct,

  -- Daily Run-Rate Target Helpers
  SAFE_DIVIDE(COALESCE(t.Revenue_Target, 0), EXTRACT(DAY FROM LAST_DAY(COALESCE(s.Month, ga.Month, pm.Month, t.Month)))) AS daily_revenue_target,
  SAFE_DIVIDE(COALESCE(t.Profit_Target, 0), EXTRACT(DAY FROM LAST_DAY(COALESCE(s.Month, ga.Month, pm.Month, t.Month)))) AS daily_profit_target,
  SAFE_DIVIDE(COALESCE(t.Spend_Target, 0), EXTRACT(DAY FROM LAST_DAY(COALESCE(s.Month, ga.Month, pm.Month, t.Month)))) AS daily_spend_target,
  SAFE_DIVIDE(COALESCE(t.Conversions_Target, 0), EXTRACT(DAY FROM LAST_DAY(COALESCE(s.Month, ga.Month, pm.Month, t.Month)))) AS daily_orders_target,

  -- Static Delivery % Calculations
  SAFE_DIVIDE(COALESCE(s.Shopify_Revenue, 0), NULLIF(t.Revenue_Target, 0)) AS Overall_Revenue_Delivery_Pct,
  SAFE_DIVIDE(COALESCE(s.Shopify_Orders, 0), NULLIF(t.Conversions_Target, 0)) AS Overall_Order_Delivery_Pct,
  SAFE_DIVIDE(COALESCE(s.Profit, 0), NULLIF(t.Profit_Target, 0)) AS Overall_Profit_Delivery_Pct,

  -- MoM Revenue Variance
  LAG(COALESCE(s.Shopify_Revenue, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Last_Month_Revenue,
  COALESCE(s.Shopify_Revenue, 0) - LAG(COALESCE(s.Shopify_Revenue, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Diff_MoM_Revenue,
  SAFE_DIVIDE(
    COALESCE(s.Shopify_Revenue, 0) - LAG(COALESCE(s.Shopify_Revenue, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)),
    NULLIF(LAG(COALESCE(s.Shopify_Revenue, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)), 0)
  ) AS Diff_MoM_Revenue_Pct,

  -- MoM Spend Variance
  LAG(COALESCE(pm.Actual_Spend, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Last_Month_Spend,
  COALESCE(pm.Actual_Spend, 0) - LAG(COALESCE(pm.Actual_Spend, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Diff_MoM_Spend,
  SAFE_DIVIDE(
    COALESCE(pm.Actual_Spend, 0) - LAG(COALESCE(pm.Actual_Spend, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)),
    NULLIF(LAG(COALESCE(pm.Actual_Spend, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)), 0)
  ) AS Diff_MoM_Spend_Pct,

  -- MoM New Customers Variance
  LAG(COALESCE(s.New_Customers, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Last_Month_New_Customers,
  COALESCE(s.New_Customers, 0) - LAG(COALESCE(s.New_Customers, 0)) OVER (ORDER BY COALESCE(s.Month, ga.Month, pm.Month, t.Month)) AS Diff_MoM_New_Customers

FROM shopify_daily s
FULL OUTER JOIN ga_daily ga
  ON s.Month = ga.Month
FULL OUTER JOIN paidmedia_daily pm
  ON COALESCE(s.Month, ga.Month) = pm.Month
FULL OUTER JOIN `entertablename.Forecasting.stg_alltargets` t
  ON COALESCE(s.Month, ga.Month, pm.Month) = t.Month;
