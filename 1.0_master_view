CREATE OR REPLACE VIEW `your_project.analytics.vw_pacing_master_dashboard` AS

WITH daily_paid_media AS (
  SELECT 
    date,
    channel,
    SUM(cost) AS cost,
    SUM(impressions) AS impressions,
    SUM(clicks) AS clicks
  FROM `your_project.raw_funnel.paid_media`
  GROUP BY 1, 2
),

daily_ga_delivery AS (
  SELECT 
    date,
    channel,
    SUM(sessions) AS sessions,
    SUM(ga_transactions) AS ga_transactions,
    SUM(ga_revenue) AS ga_revenue
  FROM `your_project.raw_ga4.delivery`
  GROUP BY 1, 2
),

daily_shopify_actuals AS (
  SELECT 
    date,
    SUM(shopify_orders) AS total_shopify_orders,
    SUM(shopify_revenue) AS total_shopify_revenue
  FROM `your_project.raw_shopify.delivery`
  GROUP BY 1
),

-- Step 1: Base Unified Delivery
unified_channel_delivery AS (
  SELECT 
    COALESCE(p.date, g.date) AS date,
    COALESCE(p.channel, g.channel) AS channel,
    COALESCE(p.cost, 0) AS actual_cost,
    COALESCE(p.impressions, 0) AS impressions,
    COALESCE(p.clicks, 0) AS clicks,
    COALESCE(g.sessions, 0) AS sessions,
    COALESCE(g.ga_transactions, 0) AS actual_conversions,
    COALESCE(g.ga_revenue, 0) AS actual_ga_revenue
  FROM daily_paid_media p
  FULL OUTER JOIN daily_ga_delivery g
    ON p.date = g.date 
   AND p.channel = g.channel
),

-- Step 2: Calendar & Run-Rate Engine Logic
runrate_context AS (
  SELECT 
    d.date,
    d.channel,
    d.actual_cost,
    d.impressions,
    d.clicks,
    d.sessions,
    d.actual_conversions,
    d.actual_ga_revenue,
    
    -- Calendar fields (Matching your top spreadsheet row)
    EXTRACT(DAY FROM LAST_DAY(d.date)) AS days_in_month,
    EXTRACT(DAY FROM d.date) AS day_of_month,
    (EXTRACT(DAY FROM LAST_DAY(d.date)) - EXTRACT(DAY FROM d.date)) AS remaining_days,
    SAFE_DIVIDE(EXTRACT(DAY FROM d.date), EXTRACT(DAY FROM LAST_DAY(d.date))) AS pct_days_in_month,

    -- Targets
    COALESCE(t.spend_target, 0) AS spend_target,
    COALESCE(t.conversions_target, 0) AS conversions_target,
    COALESCE(t.revenue_target, 0) AS revenue_target,
    
    -- Average Target Run Rate (£/day & Units/day)
    SAFE_DIVIDE(COALESCE(t.spend_target, 0), EXTRACT(DAY FROM LAST_DAY(d.date))) AS avg_target_run_rate_spend,
    SAFE_DIVIDE(COALESCE(t.conversions_target, 0), EXTRACT(DAY FROM LAST_DAY(d.date))) AS avg_target_run_rate_acqs,
    
    -- Current Actual Run Rate (£/day & Units/day based on MTD)
    SAFE_DIVIDE(d.actual_cost, EXTRACT(DAY FROM d.date)) AS current_run_rate_spend,
    SAFE_DIVIDE(d.actual_conversions, EXTRACT(DAY FROM d.date)) AS current_run_rate_acqs
  FROM unified_channel_delivery d
  LEFT JOIN `your_project.google_sheets.marketing_targets_master` t
    ON FORMAT_DATE('%Y-%m-01', d.date) = CAST(t.month AS STRING)
   AND d.channel = t.channel
)

-- Step 3: Final Output matching spreadsheet calculations
SELECT 
  r.date,
  FORMAT_DATE('%Y-%m-01', r.date) AS month_start,
  r.channel,
  
  -- Calendar Context
  r.days_in_month,
  r.day_of_month,
  r.remaining_days,
  r.pct_days_in_month,
  
  -- MTD Actuals & Targets
  r.spend_target AS budget,
  r.actual_cost AS spend_mtd,
  r.conversions_target AS acqs_target,
  r.actual_conversions AS acqs_mtd,
  
  -- Percentages Delivered
  SAFE_DIVIDE(r.actual_cost, NULLIF(r.spend_target, 0)) AS pct_delivered_spend,
  SAFE_DIVIDE(r.actual_conversions, NULLIF(r.conversions_target, 0)) AS pct_delivered_acqs,
  
  -- Run-Rate Calculations (Expected Delivery)
  r.avg_target_run_rate_spend,
  r.current_run_rate_spend,
  (r.current_run_rate_spend * r.days_in_month) AS spend_run_rate_expected,
  ((r.spend_target) - (r.actual_cost)) AS remaining_spend,
  
  r.avg_target_run_rate_acqs,
  r.current_run_rate_acqs,
  (r.current_run_rate_acqs * r.days_in_month) AS acqs_run_rate_expected,
  ((r.conversions_target) - (r.actual_conversions)) AS remaining_acqs,
  
  -- Variance vs Budget
  ((r.current_run_rate_spend * r.days_in_month) - r.spend_target) AS diff_vs_budget_spend_amt,
  SAFE_DIVIDE((r.current_run_rate_spend * r.days_in_month) - r.spend_target, NULLIF(r.spend_target, 0)) AS diff_vs_budget_spend_pct,
  
  ((r.current_run_rate_acqs * r.days_in_month) - r.conversions_target) AS diff_vs_budget_acqs_amt,
  SAFE_DIVIDE((r.current_run_rate_acqs * r.days_in_month) - r.conversions_target, NULLIF(r.conversions_target, 0)) AS diff_vs_budget_acqs_pct,

  -- Macro Financial Efficiency & Shopify Actuals
  s.total_shopify_orders,
  s.total_shopify_revenue,
  SAFE_DIVIDE(s.total_shopify_revenue, NULLIF(r.actual_cost, 0)) AS mer,
  SAFE_DIVIDE(r.actual_cost, NULLIF(s.total_shopify_orders, 0)) AS blended_cac

FROM runrate_context r
LEFT JOIN daily_shopify_actuals s 
  ON r.date = s.date;
