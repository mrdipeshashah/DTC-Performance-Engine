SELECT DISTINCT 'PaidMedia' AS source, Channel FROM `entertablename.Forecasting.dailypaidmedia`
UNION DISTINCT
SELECT DISTINCT 'GoogleAnalytics', Channel FROM `entertablename.Forecasting.dailygoogleanalytics`
UNION DISTINCT
SELECT DISTINCT 'ChannelsTargets', Channel FROM `entertablename.Forecasting.channelstarget`
ORDER BY Channel, source;
