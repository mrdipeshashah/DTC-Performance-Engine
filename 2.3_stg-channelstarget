SELECT
  CAST(Month AS DATE) AS Month,
  TRIM(Channel) AS Channel,
  Campaign,
  CAST(Spend_Target AS NUMERIC) AS Spend_Target,
  CAST(Conversions_Target AS INT64) AS Conversions_Target,
  CAST(Target_CPA AS NUMERIC) AS Target_CPA,
  CAST(Revenue_Target AS NUMERIC) AS Revenue_Target,
  Notes
FROM `entertablename.Forecasting.channelstarget`;
