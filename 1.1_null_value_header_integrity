SELECT 
  'Shopify Nulls/Zeros' AS check_name,
  COUNTIF(Date IS NULL) AS null_dates,
  COUNTIF(Shopify_Revenue IS NULL) AS null_revenues,
  COUNTIF(Profit IS NULL) AS null_profits
FROM `mrdipeshashah.Forecasting.shopify`

UNION ALL

SELECT 
  'Paid Media Nulls/Zeros',
  COUNTIF(Date IS NULL),
  COUNTIF(Cost IS NULL),
  0
FROM `mrdipeshashah.Forecasting.paidmedia`;
